{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AX-06 bounded worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "task_id",
    "provider",
    "workspace",
    "starting_sha",
    "changed_paths",
    "summary",
    "worker_exit_status",
    "worker_completed",
    "warnings",
    "requested_approval",
    "failure_reason"
  ],
  "properties": {
    "execution_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^(CHW|KLO|MKT)-06-[0-9]{2}$" },
    "provider": { "const": "local-agent" },
    "workspace": { "type": "string", "minLength": 1 },
    "starting_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "changed_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "summary": { "type": "string" },
    "worker_exit_status": { "type": "integer" },
    "worker_completed": { "const": false },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "requested_approval": { "type": "boolean" },
    "failure_reason": { "type": ["string", "null"] }
  }
}
