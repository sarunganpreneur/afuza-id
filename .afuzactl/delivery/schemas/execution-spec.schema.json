{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AX-06 task execution specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "project_id", "approval_id", "task_id", "task_title", "objective", "repo_path", "source_branch", "task_branch", "workspace_path", "starting_sha", "task_state", "approval_required", "dependencies", "allowed_paths", "forbidden_paths", "autonomous_actions_allowed", "approval_boundaries", "acceptance_criteria", "acceptance_gate_map", "verification_gates", "generic_quality_gates", "staging_validation", "production_forbidden"],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "project_id": { "enum": ["chalwa.id", "klodhost", "marketing-agency"] },
    "approval_id": { "const": "AX-06" },
    "task_id": { "type": "string", "pattern": "^(CHW|KLO|MKT)-06-[0-9]{2}$" },
    "task_title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "repo_path": { "type": "string", "minLength": 1 },
    "source_branch": { "type": "string", "minLength": 1 },
    "task_branch": { "type": "string", "pattern": "^ax06/(chalwa|klodhost|marketing-agency)/(CHW|KLO|MKT)-06-[0-9]{2}$" },
    "workspace_path": { "type": "string", "minLength": 1 },
    "starting_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "task_state": { "type": "string" },
    "approval_required": { "type": "boolean" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_gate_map": { "type": "array", "items": { "type": "object", "required": ["criterion", "gate_ids"], "properties": { "criterion": { "type": "string" }, "gate_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }, "additionalProperties": false } },
    "acceptance_gates": { "type": "object" },
    "verification_gates": { "type": "array", "items": { "type": "string" } },
    "verification_gate_map": { "type": "object" },
    "generic_quality_gates": { "type": "array", "items": { "enum": ["lint", "typecheck", "test", "build", "git_diff_check"] } },
    "generic_gate_definitions": { "type": "object" },
    "allowed_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "autonomous_actions_allowed": { "type": "array", "items": { "type": "string" } },
    "approval_boundaries": { "type": "array", "items": { "type": "string" } },
    "sensitive_boundaries_triggered": { "type": "array", "items": { "type": "string" } },
    "staging_validation": { "type": "object", "required": ["staging_url", "health_url", "ready_url", "deployment_enabled"], "properties": { "staging_url": { "type": "string", "format": "uri" }, "health_url": { "type": "string", "format": "uri" }, "ready_url": { "type": "string", "format": "uri" }, "required_mode_markers": { "type": "array", "items": { "type": "string" } }, "forbidden_live_markers": { "type": "array", "items": { "type": "string" } }, "deployment_enabled": { "const": false } }, "additionalProperties": false },
    "production_forbidden": { "const": true },
    "source_of_truth": { "type": "boolean" },
    "execution_mode": { "type": "string" },
    "task_index": { "type": "integer", "minimum": 0 }
  }
}
