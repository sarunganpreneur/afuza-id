{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "project_id", "capability", "source_reference", "source_section", "title", "description", "priority", "business_acceptance_criteria", "technical_verification_criteria", "dependencies", "shared_capability_dependencies", "autonomy_level", "approval_required", "implementation_evidence", "implementation_state", "confidence", "unresolved_questions", "readiness_status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "source_reference": { "type": "string", "minLength": 1 },
    "source_section": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2", "P3", "P4", "UNSET"] },
    "business_acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "technical_verification_criteria": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "shared_capability_dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "autonomy_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "UNKNOWN"] },
    "approval_required": { "type": "boolean" },
    "implementation_evidence": { "type": "array", "items": { "type": "string" } },
    "implementation_state": { "enum": ["NOT_STARTED", "IN_PROGRESS", "IMPLEMENTED", "VERIFIED", "UNKNOWN"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "readiness_status": { "enum": ["ACCEPTANCE_INCOMPLETE", "SPEC_INCOMPLETE", "DEPENDENCY_BLOCKED", "EXECUTION_SPEC_READY", "AUTONOMOUS_BUILD_READY", "IMPLEMENTATION_IN_PROGRESS", "READY_FOR_HUMAN_TEST", "PRODUCTION"] }
  },
  "additionalProperties": false
}
