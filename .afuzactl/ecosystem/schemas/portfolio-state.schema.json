{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "active_batch_id", "completed_actions", "inbox_imports", "decisions", "external_evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "active_batch_id": { "type": ["string", "null"] },
    "completed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_id", "project_id", "completed_at"],
        "properties": {
          "action_id": { "type": "string" },
          "project_id": { "type": "string" },
          "completed_at": { "type": "string", "format": "date-time" },
          "inventory_path": { "type": "string" },
          "result_path": { "type": "string" },
          "action_type": { "enum": ["READ_ONLY_INVENTORY", "BOOTSTRAP", "IMPLEMENT", "VERIFY", "DEPLOY_STAGING"] }
        },
        "additionalProperties": false
      }
    },
    "inbox_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "sha256", "imported_at", "record_count"],
        "properties": {
          "artifact_id": { "type": "string" },
          "artifact_type": { "enum": ["source_reconciliation", "business_decision", "external_evidence"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "imported_at": { "type": "string", "format": "date-time" },
          "record_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "project_id", "category", "title", "status", "authority", "recorded_at", "source", "statements"],
        "properties": {
          "decision_id": { "type": "string", "minLength": 1 },
          "project_id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["REPOSITORY_OWNERSHIP", "DOMAIN_OWNERSHIP", "SHARED_CAPABILITY_OWNERSHIP", "DATA_OWNERSHIP", "EXTERNAL_BUSINESS_DECISION"] },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["APPROVED", "REJECTED", "SUPERSEDED"] },
          "authority": { "enum": ["AUTHORITATIVE_USER_DECISION", "INBOX_EXTERNAL_EVIDENCE"] },
          "recorded_at": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "minLength": 1 },
          "queue_action_id": { "type": "string" },
          "statements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "external_evidence": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": false
}
