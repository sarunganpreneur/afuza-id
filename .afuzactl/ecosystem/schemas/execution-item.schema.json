{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "project_id", "classification", "title", "dependencies", "business_value", "readiness", "shared_capability_leverage", "risk", "resource_constraints", "could_run_in_parallel", "parallel_group", "evidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["READY_TO_PLAN", "WAITING_DEPENDENCY", "SPEC_GAP", "HUMAN_DECISION", "EXTERNAL_SOURCE_REQUIRED"] },
    "title": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "business_value": { "type": "string" },
    "readiness": { "type": "string" },
    "shared_capability_leverage": { "type": "string" },
    "risk": { "enum": ["low", "medium", "high", "unknown"] },
    "resource_constraints": { "type": "array", "items": { "type": "string" } },
    "could_run_in_parallel": { "type": "boolean" },
    "parallel_group": { "type": ["string", "null"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "action_type": { "enum": ["READ_ONLY_INVENTORY", "BOOTSTRAP", "IMPLEMENT", "VERIFY", "DEPLOY_STAGING", "HUMAN_APPROVAL"] },
    "permission_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] },
    "approval_requirements": { "type": "array", "items": { "type": "string" } },
    "resource_scopes": { "type": "array", "items": { "type": "string" } },
    "repository_path": { "type": "string" },
    "repository_paths": { "type": "array", "items": { "type": "string" } },
    "infrastructure_mutation": { "type": "boolean" },
    "infrastructure_scopes": { "type": "array", "items": { "type": "string" } },
    "decision_id": { "type": "string" },
    "bootstrap_scope": { "enum": ["REPOSITORY_SKELETON_ONLY"] },
    "target_path": { "type": "string" },
    "expected_outputs": { "type": "array", "items": { "type": "string" } },
    "stop_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
