{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "generated_at", "planning_only", "projects_evaluated", "collisions", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "planning_only": { "const": true },
    "projects_evaluated": { "type": "integer", "minimum": 1 },
    "collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_ids", "reasons"],
        "properties": {
          "action_ids": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "action_id", "action_type", "objective", "classification", "mode", "dependencies", "permission_level", "approvals", "readiness", "risk", "environment_available", "shared_capability_context", "shared_capability_leverage", "parallel_safe", "collision_reasons", "reason"],
        "properties": {
          "project_id": { "type": "string" },
          "action_id": { "type": "string" },
          "action_type": { "enum": ["READ_ONLY_INVENTORY", "BOOTSTRAP", "IMPLEMENT", "VERIFY", "DEPLOY_STAGING", "HUMAN_APPROVAL"] },
          "objective": { "type": "string" },
          "classification": { "enum": ["RUN_NOW", "PARALLEL", "WAITING_DEPENDENCY", "SPEC_GAP", "EXTERNAL_SOURCE_REQUIRED", "HUMAN_DECISION", "COMPLETED"] },
          "mode": { "enum": ["READ_ONLY", "MUTATING"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "permission_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] },
          "approvals": { "type": "array", "items": { "type": "string" } },
          "readiness": { "type": "string" },
          "risk": { "enum": ["low", "medium", "high", "unknown"] },
          "environment_available": { "type": "boolean" },
          "shared_capability_context": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability_id", "classification", "owner_status", "provider_project"],
              "properties": {
                "capability_id": { "type": "string" },
                "classification": { "type": "string" },
                "owner_status": { "type": "string" },
                "provider_project": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "shared_capability_leverage": { "type": "string" },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "resource_scopes": { "type": "array", "items": { "type": "string" } },
          "repository_path": { "type": ["string", "null"] },
          "repository_paths": { "type": "array", "items": { "type": "string" } },
          "infrastructure_mutation": { "type": "boolean" },
          "infrastructure_scopes": { "type": "array", "items": { "type": "string" } },
          "decision_id": { "type": ["string", "null"] },
          "bootstrap_scope": { "type": ["string", "null"] },
          "target_path": { "type": ["string", "null"] },
          "target_path_available": { "type": "boolean" },
          "expected_outputs": { "type": "array", "items": { "type": "string" } },
          "stop_conditions": { "type": "array", "items": { "type": "string" } },
          "parallel_safe": { "type": "boolean" },
          "collision_reasons": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
