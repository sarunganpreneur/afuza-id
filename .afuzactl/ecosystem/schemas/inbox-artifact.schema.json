{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "artifact_type", "artifact_id", "created_at", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "enum": ["source_reconciliation", "business_decision", "external_evidence"] },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "records": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact_type": { "const": "source_reconciliation" } }, "required": ["artifact_type"] },
      "then": { "properties": { "records": { "items": { "type": "object", "required": ["source_id", "project_id", "external_document_id", "authority_classification", "reconciliation_status", "evidence_summary"], "properties": { "source_id": { "type": "string", "minLength": 1 }, "project_id": { "type": "string", "minLength": 1 }, "external_document_id": { "type": "string", "minLength": 10 }, "authority_classification": { "enum": ["AUTHORITATIVE", "CANDIDATE", "SUPPORTING", "STALE", "CONFLICTING", "UNKNOWN"] }, "reconciliation_status": { "enum": ["ID_VERIFIED", "METADATA_VERIFIED", "CONTENT_RECONCILED", "CONTENT_NOT_INSPECTED"] }, "evidence_summary": { "type": "array", "items": { "type": "string", "maxLength": 500 } }, "contents_copied_to_repository": { "const": false } }, "additionalProperties": false } } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "business_decision" } }, "required": ["artifact_type"] },
      "then": { "properties": { "records": { "items": { "type": "object", "required": ["decision_id", "project_id", "topic", "outcome", "status", "evidence_summary"], "properties": { "decision_id": { "type": "string", "minLength": 1 }, "project_id": { "type": "string", "minLength": 1 }, "topic": { "type": "string", "minLength": 1, "maxLength": 200 }, "outcome": { "type": "string", "minLength": 1, "maxLength": 500 }, "status": { "enum": ["APPROVED", "REJECTED", "SUPERSEDED"] }, "evidence_summary": { "type": "array", "items": { "type": "string", "maxLength": 500 } } }, "additionalProperties": false } } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "external_evidence" } }, "required": ["artifact_type"] },
      "then": { "properties": { "records": { "items": { "type": "object", "required": ["evidence_id", "project_id", "category", "summary", "source_reference"], "properties": { "evidence_id": { "type": "string", "minLength": 1 }, "project_id": { "type": "string", "minLength": 1 }, "category": { "type": "string", "minLength": 1, "maxLength": 100 }, "summary": { "type": "string", "minLength": 1, "maxLength": 500 }, "source_reference": { "type": "string", "minLength": 1, "maxLength": 500 } }, "additionalProperties": false } } } }
    }
  ],
  "additionalProperties": false
}
