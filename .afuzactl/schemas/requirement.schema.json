{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "source", "title", "description", "priority", "dependencies", "acceptance_criteria", "verification_methods", "verification_evidence", "constraints", "implementation_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" },
    "source": { "type": "object", "required": ["document", "section"], "properties": { "document": { "type": "string", "minLength": 1 }, "section": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "verification_methods": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "verification_evidence": { "type": "array", "items": { "type": "object", "required": ["acceptance_criterion", "method", "result", "evidence"], "properties": { "acceptance_criterion": { "type": "string", "minLength": 1 }, "method": { "type": "string", "minLength": 1 }, "result": { "enum": ["PASS", "FAIL"] }, "evidence": { "type": "string", "minLength": 1 } }, "additionalProperties": false }, "uniqueItems": true },
    "constraints": { "type": "object", "required": ["permission_level", "approval_required"], "properties": { "permission_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] }, "approval_required": { "type": "boolean" }, "approval_reason": { "type": "string" } }, "additionalProperties": false },
    "implementation_status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "IMPLEMENTED", "VERIFIED", "BLOCKED"] }
  },
  "additionalProperties": false
}
